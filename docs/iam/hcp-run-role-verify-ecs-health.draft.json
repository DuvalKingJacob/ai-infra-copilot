{
  "_comment": "DRAFT FOR REVIEW ONLY. Not applied anywhere. Proposed ADDITIONS for the HCP Terraform run role (arn:aws:iam::009365819213:role/hcp-terraform-ai-infra-copilot) so it can create and invoke the verify-ecs-health Lambda. Review against the role's current policy first; these are additive. See docs/ecs-health-verification.md.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageVerifyEcsHealthFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionRecursionConfig",
        "lambda:GetPolicy",
        "lambda:ListVersionsByFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:ListTags",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": "arn:aws:lambda:us-east-1:009365819213:function:payments-*-verify-ecs-health"
    },
    {
      "Sid": "InvokeVerifyEcsHealthFunction",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:009365819213:function:payments-*-verify-ecs-health"
    },
    {
      "Sid": "ManageVerifyEcsHealthRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::009365819213:role/payments-*-verify-ecs-health-role"
    },
    {
      "Sid": "PassVerifyRoleToLambdaOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::009365819213:role/payments-*-verify-ecs-health-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageVerifyEcsHealthLogGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:ListTagsForResource",
        "logs:ListTagsLogGroup",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:009365819213:log-group:/aws/lambda/payments-*-verify-ecs-health",
        "arn:aws:logs:us-east-1:009365819213:log-group:/aws/lambda/payments-*-verify-ecs-health:*"
      ]
    },
    {
      "Sid": "DescribeLogGroups",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    }
  ]
}
