{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageVerifyEcsHealthFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": "arn:aws:lambda:us-east-1:009365819213:function:payments-production-verify-ecs-health"
    },
    {
      "Sid": "InvokeVerifyEcsHealthFunction",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:009365819213:function:payments-production-verify-ecs-health"
    },
    {
      "Sid": "ManageVerifyEcsHealthRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::009365819213:role/payments-production-verify-ecs-health-role"
    },
    {
      "Sid": "PassVerifyRoleToLambdaOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::009365819213:role/payments-production-verify-ecs-health-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    }
  ]
}
