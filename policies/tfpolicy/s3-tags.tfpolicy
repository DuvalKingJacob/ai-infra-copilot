# Production tagging governance policy for S3 storage assets.

policy "require-s3-production-tags" {
  enforcement_level = "soft-mandatory"
}

locals {
  # When evaluated against plan
  plan_resources = [
    for change in try(core.plan.resource_changes, []) :
    change if try(change.type, "") == "aws_s3_bucket"
  ]

  # When evaluated against search / live resource inventory
  query_resources = [
    for r in try(core.resources, []) :
    r if try(r.type, "") == "aws_s3_bucket"
  ]

  all_targets = length(local.plan_resources) > 0 ? local.plan_resources : local.query_resources
}

enforce {
  for_each = local.all_targets
  each.key = "s3_required_tags"

  condition = (
    try(each.value.change.after.tags.Environment, null) != null &&
    try(each.value.change.after.tags.Owner, null) != null
  ) || (
    try(each.value.tags.Environment, null) != null &&
    try(each.value.tags.Owner, null) != null
  )

  error_message = "S3 bucket '${try(each.value.address, each.value.name, "discovered-bucket")}' is missing mandatory governance tags ('Environment', 'Owner'). All production storage assets must declare an owner and target environment."
}
